# Netlify: same policy as vercel.json. connect-src 'self' means the browser itself refuses to send
# anything to another server, which is what "your CV stays on your device" relies on.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' data: blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# HTML already gets Netlify's default max-age=0, must-revalidate; hashed assets never change.

/assets/*
  Cache-Control: public, max-age=31536000, immutable
